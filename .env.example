# Godavari Wave Technologies - Environment Configuration Example
# Copy this file to .env and replace placeholders with actual values.

# Admin Dashboard Authentication
VITE_ADMIN_USERNAME=godavarihrdashboard
VITE_ADMIN_PASSWORD=your_secure_password_here

# Supabase PostgreSQL Database Connection
# Pooler Connection (recommended for pooling and IPv4 support)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Direct Connection
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
